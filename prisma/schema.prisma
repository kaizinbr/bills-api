// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client"
    output   = "../lib/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model User {
    id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    name          String
    email         String
    emailVerified Boolean
    image         String?
    createdAt     DateTime
    updatedAt     DateTime
    sessions      Session[]
    accounts      Account[]

    debtorGroups     Group[]    @relation("DebtorGroups")
    creditorGroups   Group[]    @relation("CreditorGroups")
    purchasesCreated Purchase[]

    ownedCards   Card[] @relation("OwnedCards")
    createdCards Card[] @relation("CreatedCards")

    createdCategories    Category[]
    createdSubscriptions Subscription[]

    @@unique([email])
    @@map("user")
}

model Session {
    id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    expiresAt DateTime
    token     String
    createdAt DateTime
    updatedAt DateTime
    ipAddress String?
    userAgent String?
    userId    String   @db.Uuid
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([token])
    @@map("session")
}

model Account {
    id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    accountId             String
    providerId            String
    issuer                String
    userId                String    @db.Uuid
    user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    accessToken           String?
    refreshToken          String?
    idToken               String?
    accessTokenExpiresAt  DateTime?
    refreshTokenExpiresAt DateTime?
    scope                 String?
    password              String?
    createdAt             DateTime
    updatedAt             DateTime

    @@unique([issuer, accountId])
    @@map("account")
}

model Verification {
    id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    identifier String
    value      String
    expiresAt  DateTime
    createdAt  DateTime?
    updatedAt  DateTime?

    @@map("verification")
}

model Group {
    id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    name String

    debtorId String @db.Uuid
    debtor   User   @relation("DebtorGroups", fields: [debtorId], references: [id], onDelete: Cascade)

    creditorId   String? @db.Uuid
    creditor     User?   @relation("CreditorGroups", fields: [creditorId], references: [id], onDelete: SetNull)
    creditorName String?

    closingDay Int?

    archived  Boolean  @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    cards    Card[]
    invoices Invoice[]

    @@index([debtorId])
    @@index([creditorId])
    @@map("group")
}

model Card {
    id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    name   String
    color  String?
    digits String?

    closingDay Int?

    ownerId String @db.Uuid
    owner   User   @relation("OwnedCards", fields: [ownerId], references: [id], onDelete: Cascade)

    createdById String @db.Uuid
    createdBy   User   @relation("CreatedCards", fields: [createdById], references: [id], onDelete: Cascade)

    archived  Boolean  @default(false)
    groupId   String   @db.Uuid
    group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    invoices      Invoice[]
    subscriptions Subscription[]
    purchases     Purchase[]

    @@index([groupId])
    @@index([ownerId])
    @@map("card")
}

enum InvoiceStatus {
    OPEN
    CLOSED
    PAID

    @@map("invoice_status")
}

model Invoice {
    id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

    groupId String @db.Uuid
    group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

    cardId String? @db.Uuid
    card   Card?   @relation(fields: [cardId], references: [id], onDelete: Cascade)

    periodStart DateTime
    closingDate DateTime
    status      InvoiceStatus @default(OPEN)
    paidAt      DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    purchases Purchase[]

    @@unique([cardId, periodStart])
    @@index([groupId, periodStart])
    @@map("invoice")
}

model Purchase {
    id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    description String?
    amount      Decimal  @db.Decimal(10, 2)
    purchasedAt DateTime @default(now())

    categoryId String   @db.Uuid
    category   Category @relation(fields: [categoryId], references: [id])

    invoiceId String  @db.Uuid
    invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

    cardId String? @db.Uuid
    card   Card?   @relation(fields: [cardId], references: [id], onDelete: SetNull)

    installmentGroupId String? @db.Uuid
    installmentNumber  Int?
    installmentTotal   Int?

    subscriptionId String?       @db.Uuid
    subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

    createdById String   @db.Uuid
    createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@unique([invoiceId, subscriptionId])
    @@index([invoiceId, purchasedAt])
    @@index([cardId, purchasedAt])
    @@index([installmentGroupId])
    @@index([categoryId])
    @@index([subscriptionId])
    @@map("purchase")
}

enum CategoryType {
    FOOD
    TRANSPORT
    SHOPPING
    HEALTH
    ENTERTAINMENT
    SUBSCRIPTION
    INSTALLMENT
    LOAN
    BILLS
    OTHER

    @@map("category_type")
}

model Category {
    id    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    key   String       @unique
    label String
    icon  String?
    type  CategoryType @default(OTHER)

    createdById String? @db.Uuid
    createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: Cascade)

    archived  Boolean  @default(false)
    createdAt DateTime @default(now())

    purchases     Purchase[]
    subscriptions Subscription[]

    @@index([type])
    @@map("category")
}

model Subscription {
    id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    name       String
    amount     Decimal   @db.Decimal(10, 2)
    chargeDay  Int
    startDate  DateTime  @default(now())
    canceledAt DateTime?

    categoryId String   @db.Uuid
    category   Category @relation(fields: [categoryId], references: [id])

    cardId String @db.Uuid
    card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

    createdById String @db.Uuid
    createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    purchases Purchase[]

    @@index([cardId])
    @@index([canceledAt])
    @@map("subscription")
}
